="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-144"><g transform="translate(0.5,0.5)"><rect x="1045" y="226" width="260" height="60" rx="9" ry="9" fill="#f5f5f5" stroke="#999999" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(245, 245, 245), rgb(26, 26, 26)); stroke: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 258px; height: 1px; padding-top: 256px; margin-left: 1046px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><font face="Times New Roman"><i style="">u</i><sub style="">pred</sub>(<i style="">p</i>) = γ <i style="">u</i><sub style="">GGGF</sub>(<i style="">p</i>) + <i style="">f</i>(<i style="">d</i>) Φ(<i style="">p</i>; θ)</font></div></div></div></foreignObject><text x="1175" y="260" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">upred(p) = γ uGGGF(p) + f(d) Φ(p; θ)</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-146"><g transform="translate(0.5,0.5)"><ellipse cx="980" cy="101.23" rx="35" ry="35" fill="#fff2cc" stroke="#d6b656" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(255, 242, 204), rgb(40, 29, 0)); stroke: light-dark(rgb(214, 182, 86), rgb(109, 81, 0));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 68px; height: 1px; padding-top: 101px; margin-left: 946px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 16px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><i>u</i><sub>GGGF</sub>(<i>p</i>)</div></div></div></foreignObject><text x="980" y="106" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="16px" text-anchor="middle">uGGGF(p)</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-147"><g transform="translate(0.5,0.5)"><rect x="1015" y="76.23" width="107.5" height="50" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 106px; height: 1px; padding-top: 101px; margin-left: 1016px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 13px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">Global Geometric<br />Guidance Field</div></div></div></foreignObject><text x="1069" y="105" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="13px" text-anchor="middle">Global Geometric...</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-148"><g transform="translate(0.5,0.5)"><path d="M 1004.75 125.98 L 1042.62 220.09" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 1044.58 224.96 L 1038.72 219.78 L 1042.62 220.09 L 1045.22 217.16 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-149"><g><rect x="1066.25" y="131" width="217.5" height="75" rx="11.25" ry="11.25" fill="none" stroke="#b6abc3" stroke-width="3" stroke-dasharray="9 9" pointer-events="all" style="stroke: light-dark(rgb(182, 171, 195), rgb(149, 119, 163));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 216px; height: 1px; padding-top: 169px; margin-left: 1067px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">Hard boundary constraint:<br />as <i>d</i> → 0, residual vanishes;<br />near-wall orthogonality is enforced.</div></div></div></foreignObject><text x="1175" y="173" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">Hard boundary constraint:...</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-155"><g transform="translate(0.5,0.5)"><path d="M 1535 161 L 1555.09 161.09 L 1555.09 241.09 L 1568.63 241.03" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 1573.88 241.01 L 1566.9 244.54 L 1568.63 241.03 L 1566.87 237.54 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-150"><g transform="translate(0.5,0.5)"><rect x="1365" y="101" width="170" height="120" rx="18" ry="18" fill="#f5f5f5" stroke="#999999" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(245, 245, 245), rgb(26, 26, 26)); stroke: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 168px; height: 1px; padding-top: 161px; margin-left: 1366px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>Boundary cosine loss</b><br />align with inner-wall and<div>outer-boundary directions<br /><br /><i>L</i><sub>bc</sub> = 1 − cos(<i>u</i><sub>pred</sub>, <i>n</i><sub>b</sub>)</div></div></div></div></foreignObject><text x="1450" y="165" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">Boundary cosine loss...</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-156"><g transform="translate(0.5,0.5)"><path d="M 1535 361.23 L 1555.09 361.27 L 1555.09 271.09 L 1568.63 271.03" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 1573.88 271.01 L 1566.9 274.54 L 1568.63 271.03 L 1566.87 267.54 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-151"><g transform="translate(0.5,0.5)"><rect x="1365" y="301.23" width="170" height="120" rx="18" ry="18" fill="#f5f5f5" stroke="#999999" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(245, 245, 245), rgb(26, 26, 26)); stroke: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 168px; height: 1px; padding-top: 361px; margin-left: 1366px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>Laplacian smoothing</b><br /><br /><i>L</i><sub>lap</sub> = ||∇<sup>2</sup><i>u</i><sub>pred</sub>||<sup>2</sup><br />finite differences on <div>interior samples</div></div></div></div></foreignObject><text x="1450" y="365" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">Laplacian smoothing...</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-158"><g transform="translate(0.5,0.5)"><path d="M 1715 256 L 1738.72 256" fill="none" stroke="#000000" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/><path d="M 1743.97 256 L 1736.97 259.5 L 1738.72 256 L 1736.97 252.5 Z" fill="#000000" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-154"><g transform="translate(0.5,0.5)"><rect x="1575" y="226" width="140" height="60" rx="9" ry="9" fill="#f5f5f5" stroke="#999999" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(245, 245, 245), rgb(26, 26, 26)); stroke: light-dark(rgb(153, 153, 153), rgb(106, 106, 106));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 138px; height: 1px; padding-top: 256px; margin-left: 1576px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><i>L</i><sub>total</sub> = <i>a</i><sub>0</sub><i>L</i><sub>bc</sub> + <i>a</i><sub>1</sub><i>L</i><sub>lap</sub></div></div></div></foreignObject><text x="1645" y="260" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">Ltotal = a0Lbc + a1L...</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-157"><g transform="translate(0.5,0.5)"><rect x="1745" y="238.95" width="35" height="35" rx="5.25" ry="5.25" fill="#e1d5e7" stroke="#9673a6" stroke-width="1.5" pointer-events="all" style="fill: light-dark(rgb(225, 213, 231), rgb(57, 47, 63)); stroke: light-dark(rgb(150, 115, 166), rgb(149, 119, 163));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 33px; height: 1px; padding-top: 256px; margin-left: 1746px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 14px; font-family: 'Times New Roman'; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">θ</div></div></div></foreignObject><text x="1763" y="261" fill="light-dark(#000000, #ffffff)" font-family="'Times New Roman'" font-size="14px" text-anchor="middle">θ</text></switch></g></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-162"><g transform="translate(0.5,0.5)"><path d="M 1312.62 391.02 L 1335.64 391.09 L 1358.63 391.2" fill="none" stroke="#b6abc3" stroke-miterlimit="10" stroke-dasharray="3 3" pointer-events="stroke" style="stroke: light-dark(rgb(182, 171, 195), rgb(237, 237, 237));"/><path d="M 1307.37 391 L 1314.38 387.53 L 1312.62 391.02 L 1314.36 394.53 Z" fill="#b6abc3" stroke="#b6abc3" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(182, 171, 195), rgb(237, 237, 237)); stroke: light-dark(rgb(182, 171, 195), rgb(237, 237, 237));"/><path d="M 1363.88 391.22 L 1356.87 394.69 L 1358.63 391.2 L 1356.9 387.69 Z" fill="#b6abc3" stroke="#b6abc3" stroke-miterlimit="10" pointer-events="all" style="fill: light-dark(rgb(182, 171, 195), rgb(237, 237, 237)); stroke: light-dark(rgb(182, 171, 195), rgb(237, 237, 237));"/></g></g><g data-cell-id="YsaeRUa-u6XaHC1YGcQE-160"><g><rect x="1043.75" y="351" width="262.5" height="80" rx="12" ry="12" fill="none" stroke="#b6abc3" stroke-width="3" stroke-dasharray="9 9" pointer-events="all" style="stroke: light-dark(rgb(182, 171, 195), rgb(149, 119, 163));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: lef